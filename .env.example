# Шаблон переменных окружения. Скопируйте в .env.local (локально) или задайте в панели хостинга.
# Реальные значения никогда не коммитить.

# Ключ API data.mos.ru (apidata.mos.ru). Без ключа приложение работает на последнем снимке.
DATAMOS_API_KEY=

# Корень JSON-базы. На сервере это путь к постоянному тому.
DATA_DIR=./data

# Секрет подписи cookie сессии и соль хешей устройства: длинные случайные строки.
SESSION_SECRET=
SESSION_SALT=

# Токен для POST /api/admin/hide (заголовок X-Admin-Token). Пусто = скрытие отключено.
ADMIN_TOKEN=

# Публичный адрес сервиса.
PUBLIC_URL=

# Порт (на хостинге задаётся платформой). Локально сервер слушает API_PORT (по умолчанию 3000).
PORT=3000
